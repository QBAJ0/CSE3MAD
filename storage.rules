rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /activity-evidence/{ownerUid}/{activityId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
